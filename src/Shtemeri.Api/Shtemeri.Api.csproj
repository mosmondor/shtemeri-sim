<Project Sdk="Microsoft.NET.Sdk">
  <!-- The fleet API exactly as published in the season guide (chapter 9). Fleets compile against this assembly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Shtemeri.Api</AssemblyName>
    <RootNamespace>Shtemeri.Api</RootNamespace>
  </PropertyGroup>
</Project>
